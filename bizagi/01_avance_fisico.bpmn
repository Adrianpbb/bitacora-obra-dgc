<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Avance" targetNamespace="http://dgc.mop.cl/bitacora-obra" exporter="Bitacora de Obra DGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Avance">
    <bpmn:participant id="Pool_Avance" name="Reporte y aprobación de avance físico" processRef="Proc_Avance" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Avance" name="Reporte y aprobación de avance físico" isExecutable="false">
    <bpmn:documentation>El IF/AIF propone un avance (%); el Validador lo aprueba o rechaza; solo lo aprobado pasa a ser dato oficial y lo ve Gabinete. Estados: BORRADOR, PENDIENTE_APROBACION, APROBADO, RECHAZADO, ELIMINADO.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Avance">
      <bpmn:lane id="Lane_Avance_0" name="IF / AIF">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Avance_1" name="Validador / Jefe de Depto.">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Avance_2" name="Sistema">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Avance_3" name="Gabinete">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Hay que reportar el avance">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Ingresar sector, avance % y fecha de reporte">
      <bpmn:documentation>Cargar información &gt; Cargar avance. El IF elige el contrato activo (titular o suplente) y el sector. El avance es un entero entre 0 y 100; la fecha de reporte es obligatoria.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Validar datos (0–100, fecha, sin solicitud activa)">
      <bpmn:documentation>Reglas: avance entero 0–100; fecha de reporte obligatoria; una sola solicitud activa por dato (sector).</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="¿Datos válidos?" gatewayDirection="Diverging">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Corregir datos">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T4" name="Enviar a aprobación">
      <bpmn:documentation>La solicitud pasa de BORRADOR a PENDIENTE_APROBACION. Opcional: botón &quot;Avisar por correo al aprobador&quot; (mailto: se abre en Outlook; el navegador no envía el correo). Mientras está pendiente el IF puede cancelarla (estado ELIMINADO).</bpmn:documentation>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T5" name="Registrar solicitud y recibo de auditoría">
      <bpmn:documentation>Se guarda la solicitud con su recibo de auditoría (hash SHA-256) y queda en la bandeja del Validador del contrato.</bpmn:documentation>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T6" name="Revisar: valor actual → propuesto">
      <bpmn:documentation>Bandeja de aprobaciones. Se muestra Contrato / Sector / valor actual → propuesto y la diferencia en puntos porcentuales. Nadie aprueba una solicitud que envió él mismo.</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="¿Decisión?" gatewayDirection="Diverging">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T7" name="Publicar dato oficial y guardar historial">
      <bpmn:documentation>El valor aprobado pasa a oficial (colección oficial) y se guarda el historial anterior → nuevo con fecha de aprobación y revisor.</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T8" name="Consultar avance y semáforo del contrato">
      <bpmn:documentation>Gabinete es solo lectura: ve únicamente datos APROBADOS (dashboard, radar, últimas aprobaciones).</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E1" name="Avance oficial visible">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T9" name="Escribir comentario del rechazo (mín. 5 caracteres)">
      <bpmn:documentation>El rechazo exige comentario de al menos 5 caracteres. Después se ofrece &quot;Avisar por correo al IF&quot; (mailto:) con el comentario.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T10" name="Marcar RECHAZADO y avisar al IF">
      <bpmn:documentation>La solicitud queda RECHAZADA y el IF la ve en la campanita de notificaciones con el comentario del revisor.</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Rechazada: el IF ve el motivo y puede reenviar">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="F02" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F03" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F04" name="No" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F05" sourceRef="T3" targetRef="T1" />
    <bpmn:sequenceFlow id="F06" name="Sí" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F07" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F08" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F09" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="F10" name="Aprobar" sourceRef="G2" targetRef="T7" />
    <bpmn:sequenceFlow id="F11" name="Rechazar" sourceRef="G2" targetRef="T9" />
    <bpmn:sequenceFlow id="F12" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F13" sourceRef="T8" targetRef="E1" />
    <bpmn:sequenceFlow id="F14" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F15" sourceRef="T10" targetRef="E2" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Opcional: &quot;Avisar por correo al aprobador&quot; (mailto:). El IF puede cancelar mientras esté pendiente (ELIMINADO).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_N1" sourceRef="T4" targetRef="N1" />
    <bpmn:textAnnotation id="N2"><bpmn:text>Regla: nadie aprueba lo propio. Solo el Validador del contrato ve la solicitud.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_N2" sourceRef="T6" targetRef="N2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_Avance">
    <bpmndi:BPMNPlane id="Plane_Avance" bpmnElement="Collab_Avance">
      <bpmndi:BPMNShape id="Sh_Pool" bpmnElement="Pool_Avance" isHorizontal="true"><dc:Bounds x="20" y="20" width="2143" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane0" bpmnElement="Lane_Avance_0" isHorizontal="true"><dc:Bounds x="50" y="20" width="2113" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane1" bpmnElement="Lane_Avance_1" isHorizontal="true"><dc:Bounds x="50" y="170" width="2113" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane2" bpmnElement="Lane_Avance_2" isHorizontal="true"><dc:Bounds x="50" y="320" width="2113" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane3" bpmnElement="Lane_Avance_3" isHorizontal="true"><dc:Bounds x="50" y="470" width="2113" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S" bpmnElement="S"><dc:Bounds x="167" y="77" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="130" y="117" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T1" bpmnElement="T1"><dc:Bounds x="300" y="53" width="150" height="84" /></bpmndi:BPMNShape>
