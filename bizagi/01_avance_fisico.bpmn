      <bpmndi:BPMNShape id="Sh_G1" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="730" y="370" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="695" y="422" width="120" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T3" bpmnElement="T3"><dc:Bounds x="680" y="53" width="150" height="84" /></bpmndi:BPMNShape>
