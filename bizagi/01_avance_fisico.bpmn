      <bpmndi:BPMNShape id="Sh_G2" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="1490" y="220" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1455" y="272" width="120" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T7" bpmnElement="T7"><dc:Bounds x="1630" y="353" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T8" bpmnElement="T8"><dc:Bounds x="1820" y="503" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_E1" bpmnElement="E1"><dc:Bounds x="2067" y="527" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2030" y="567" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T9" bpmnElement="T9"><dc:Bounds x="1630" y="203" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T10" bpmnElement="T10"><dc:Bounds x="1820" y="353" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_E2" bpmnElement="E2"><dc:Bounds x="2067" y="77" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="2030" y="117" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_N1" bpmnElement="N1"><dc:Bounds x="1263" y="63" width="200" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_N2" bpmnElement="N2"><dc:Bounds x="1225" y="513" width="200" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ed_F01" bpmnElement="F01">
        <di:waypoint x="203" y="95" />
        <di:waypoint x="300" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F02" bpmnElement="F02">
        <di:waypoint x="450" y="95" />
        <di:waypoint x="470" y="95" />
        <di:waypoint x="470" y="395" />
        <di:waypoint x="490" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F03" bpmnElement="F03">
        <di:waypoint x="640" y="395" />
        <di:waypoint x="730" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F04" bpmnElement="F04">
        <di:waypoint x="755" y="370" />
        <di:waypoint x="755" y="137" />
        <bpmndi:BPMNLabel><dc:Bounds x="761" y="245" width="19" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F05" bpmnElement="F05">
