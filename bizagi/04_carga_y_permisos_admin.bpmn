        <di:waypoint x="2257" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_As_N1" bpmnElement="As_N1"><di:waypoint x="489" y="213" /><di:waypoint x="490" y="95" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
