        <di:waypoint x="1610" y="245" />
        <di:waypoint x="1630" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F11" bpmnElement="F11">
        <di:waypoint x="1780" y="245" />
        <di:waypoint x="1800" y="245" />
        <di:waypoint x="1800" y="95" />
        <di:waypoint x="1820" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F12" bpmnElement="F12">
        <di:waypoint x="1970" y="95" />
        <di:waypoint x="1990" y="95" />
        <di:waypoint x="1990" y="245" />
        <di:waypoint x="2010" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F13" bpmnElement="F13">
        <di:waypoint x="2160" y="245" />
