<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Problem" targetNamespace="http://dgc.mop.cl/bitacora-obra" exporter="Bitacora de Obra DGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Problem">
    <bpmn:participant id="Pool_Problem" name="Gestión de problemáticas y alertas" processRef="Proc_Problem" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Problem" name="Gestión de problemáticas y alertas" isExecutable="false">
    <bpmn:documentation>Problemáticas de terreno: Detectado → En gestión → Escalado → Resuelto. No pasan por aprobación; el Validador decide si publica una alerta a Gabinete según el riesgo de la ficha.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Problem">
      <bpmn:lane id="Lane_Problem_0" name="IF / AIF">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Problem_1" name="Validador / Jefe de Depto.">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Problem_2" name="Sistema">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Problem_3" name="Gabinete">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="¿Hay un problema en terreno?">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Registrar problemática (riesgo, stakeholders, checklist)">
      <bpmn:documentation>Título, descripción, nivel de riesgo (Extremo, Alto, Medio, Bajo), stakeholders, checklist de subsanación y fecha de vencimiento.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Guardar ficha en estado Detectado">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="P1">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="T3" name="Gestionar: checklist y notas; escalar si hace falta">
      <bpmn:documentation>Estados: Detectado → En gestión → Escalado. Escalamiento a Jefe de División, Directora, Jurídica u Otro. Cada nota queda en la bitácora de la ficha. El checklist se puede editar.</bpmn:documentation>
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="¿Se resolvió?" gatewayDirection="Diverging">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T4" name="Marcar como resuelta con el motivo (mín. 5 caracteres)">
      <bpmn:documentation>El motivo &quot;cómo / por qué se resolvió&quot; es obligatorio y queda con fecha y autor (id).</bpmn:documentation>
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T5" name="Registrar resolución y pasar a Resueltas">
      <bpmn:documentation>Se guarda texto, autor y fecha de la resolución. Si la ficha se reabre, la resolución anterior se conserva.</bpmn:documentation>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Problemática resuelta (ficha consultable)">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T6" name="Evaluar riesgo y, si corresponde, publicar alerta">
      <bpmn:documentation>Publicar o retirar la alerta a Gabinete es decisión del Validador/Jefe de Depto.</bpmn:documentation>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T7" name="Ver alerta (extrema → rojo; alta → ámbar)">
      <bpmn:documentation>Una alerta extrema publicada pone el contrato en rojo; una de riesgo alto, en ámbar. Se ve en el dashboard de Gabinete.</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E2" name="Alerta visible en el dashboard">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="F02" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F03" sourceRef="T2" targetRef="P1" />
    <bpmn:sequenceFlow id="F04" sourceRef="P1" targetRef="T3" />
    <bpmn:sequenceFlow id="F05" sourceRef="P1" targetRef="T6" />
    <bpmn:sequenceFlow id="F06" sourceRef="T3" targetRef="G1" />
    <bpmn:sequenceFlow id="F07" name="No: seguir gestionando" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F08" name="Sí" sourceRef="G1" targetRef="T4" />
    <bpmn:sequenceFlow id="F09" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F10" sourceRef="T5" targetRef="E1" />
    <bpmn:sequenceFlow id="F11" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F12" sourceRef="T7" targetRef="E2" />
    <bpmn:textAnnotation id="N1"><bpmn:text>La ficha reabierta conserva la resolución anterior. Las resueltas se consultan en la pestaña Resueltas.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_N1" sourceRef="T5" targetRef="N1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_Problem">
    <bpmndi:BPMNPlane id="Plane_Problem" bpmnElement="Collab_Problem">
      <bpmndi:BPMNShape id="Sh_Pool" bpmnElement="Pool_Problem" isHorizontal="true"><dc:Bounds x="20" y="20" width="1763" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane0" bpmnElement="Lane_Problem_0" isHorizontal="true"><dc:Bounds x="50" y="20" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane1" bpmnElement="Lane_Problem_1" isHorizontal="true"><dc:Bounds x="50" y="170" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane2" bpmnElement="Lane_Problem_2" isHorizontal="true"><dc:Bounds x="50" y="320" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane3" bpmnElement="Lane_Problem_3" isHorizontal="true"><dc:Bounds x="50" y="470" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S" bpmnElement="S"><dc:Bounds x="167" y="77" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="130" y="117" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T1" bpmnElement="T1"><dc:Bounds x="300" y="53" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T2" bpmnElement="T2"><dc:Bounds x="490" y="353" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_P1" bpmnElement="P1"><dc:Bounds x="730" y="370" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T3" bpmnElement="T3"><dc:Bounds x="870" y="53" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_G1" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="1110" y="70" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1075" y="122" width="120" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T4" bpmnElement="T4"><dc:Bounds x="1250" y="53" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T5" bpmnElement="T5"><dc:Bounds x="1440" y="353" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_E1" bpmnElement="E1"><dc:Bounds x="1687" y="77" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1650" y="117" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T6" bpmnElement="T6"><dc:Bounds x="870" y="203" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T7" bpmnElement="T7"><dc:Bounds x="1060" y="503" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_E2" bpmnElement="E2"><dc:Bounds x="1307" y="527" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1270" y="567" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_N1" bpmnElement="N1"><dc:Bounds x="1453" y="213" width="200" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ed_F01" bpmnElement="F01">
        <di:waypoint x="203" y="95" />
        <di:waypoint x="300" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F02" bpmnElement="F02">
        <di:waypoint x="450" y="95" />
        <di:waypoint x="470" y="95" />
        <di:waypoint x="470" y="395" />
        <di:waypoint x="490" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F03" bpmnElement="F03">
        <di:waypoint x="640" y="395" />
        <di:waypoint x="730" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F04" bpmnElement="F04">
        <di:waypoint x="755" y="370" />
        <di:waypoint x="755" y="95" />
        <di:waypoint x="870" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F05" bpmnElement="F05">
        <di:waypoint x="780" y="395" />
        <di:waypoint x="825" y="395" />
        <di:waypoint x="825" y="245" />
        <di:waypoint x="870" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F06" bpmnElement="F06">
        <di:waypoint x="1020" y="95" />
        <di:waypoint x="1110" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F07" bpmnElement="F07">
        <di:waypoint x="1135" y="70" />
        <di:waypoint x="1135" y="25" />
        <di:waypoint x="945" y="25" />
        <di:waypoint x="945" y="53" />
        <bpmndi:BPMNLabel><dc:Bounds x="980" y="21" width="131" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F08" bpmnElement="F08">
        <di:waypoint x="1160" y="95" />
        <di:waypoint x="1250" y="95" />
        <bpmndi:BPMNLabel><dc:Bounds x="1166" y="77" width="19" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F09" bpmnElement="F09">
        <di:waypoint x="1400" y="95" />
        <di:waypoint x="1420" y="95" />
        <di:waypoint x="1420" y="395" />
        <di:waypoint x="1440" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F10" bpmnElement="F10">
        <di:waypoint x="1590" y="395" />
        <di:waypoint x="1638" y="395" />
        <di:waypoint x="1638" y="95" />
        <di:waypoint x="1687" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F11" bpmnElement="F11">
        <di:waypoint x="1020" y="245" />
        <di:waypoint x="1040" y="245" />
        <di:waypoint x="1040" y="545" />
        <di:waypoint x="1060" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F12" bpmnElement="F12">
        <di:waypoint x="1210" y="545" />
        <di:waypoint x="1307" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_As_N1" bpmnElement="As_N1"><di:waypoint x="1553" y="277" /><di:waypoint x="1515" y="353" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
