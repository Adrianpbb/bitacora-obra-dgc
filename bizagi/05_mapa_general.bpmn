<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_Mapa" targetNamespace="http://dgc.mop.cl/bitacora-obra" exporter="Bitacora de Obra DGC" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Mapa">
    <bpmn:participant id="Pool_Mapa" name="Bitácora de Obra: mapa general del flujo" processRef="Proc_Mapa" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Mapa" name="Bitácora de Obra: mapa general del flujo" isExecutable="false">
    <bpmn:documentation>Vista de una página: quién hace qué, cómo se aprueba la información y qué ve Gabinete.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Mapa">
      <bpmn:lane id="Lane_Mapa_0" name="Administrador">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mapa_1" name="IF / AIF">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mapa_2" name="Validador / Jefe de Depto.">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mapa_3" name="Sistema">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mapa_4" name="Gabinete">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Inicio del piloto">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Cargar contratos y subsectores; asignar perfiles">
      <bpmn:documentation>Detalle en el proceso 04.</bpmn:documentation>
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="Reportar avance, fechas de hitos o problemáticas">
      <bpmn:documentation>Detalle en los procesos 01 (avance), 02 (hitos) y 03 (problemáticas).</bpmn:documentation>
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T3" name="Registrar solicitud pendiente y avisar al Validador">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T4" name="Revisar y decidir">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="¿Aprueba?" gatewayDirection="Diverging">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T5" name="Publicar dato oficial, historial y semáforo">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T6" name="Consultar dashboard: contratos, semáforo, radar, últimas aprobaciones">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E1" name="Información ejecutiva al día">
      <bpmn:incoming>F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T7" name="Comentar el rechazo (mín. 5 caracteres)">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T8" name="Avisar al IF (campanita; correo opcional)">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="El IF corrige y vuelve a reportar">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="F02" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F03" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F04" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F05" sourceRef="T4" targetRef="G1" />
    <bpmn:sequenceFlow id="F06" name="Sí" sourceRef="G1" targetRef="T5" />
    <bpmn:sequenceFlow id="F07" name="No" sourceRef="G1" targetRef="T7" />
    <bpmn:sequenceFlow id="F08" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F09" sourceRef="T6" targetRef="E1" />
    <bpmn:sequenceFlow id="F10" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="E2" />
    <bpmn:textAnnotation id="N1"><bpmn:text>Las problemáticas no requieren aprobación: el Validador solo decide si publica una alerta a Gabinete.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_N1" sourceRef="T2" targetRef="N1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_Mapa">
    <bpmndi:BPMNPlane id="Plane_Mapa" bpmnElement="Collab_Mapa">
      <bpmndi:BPMNShape id="Sh_Pool" bpmnElement="Pool_Mapa" isHorizontal="true"><dc:Bounds x="20" y="20" width="1763" height="750" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane0" bpmnElement="Lane_Mapa_0" isHorizontal="true"><dc:Bounds x="50" y="20" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane1" bpmnElement="Lane_Mapa_1" isHorizontal="true"><dc:Bounds x="50" y="170" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane2" bpmnElement="Lane_Mapa_2" isHorizontal="true"><dc:Bounds x="50" y="320" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane3" bpmnElement="Lane_Mapa_3" isHorizontal="true"><dc:Bounds x="50" y="470" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_Lane4" bpmnElement="Lane_Mapa_4" isHorizontal="true"><dc:Bounds x="50" y="620" width="1733" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_S" bpmnElement="S"><dc:Bounds x="167" y="77" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="130" y="117" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T1" bpmnElement="T1"><dc:Bounds x="300" y="53" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T2" bpmnElement="T2"><dc:Bounds x="490" y="203" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T3" bpmnElement="T3"><dc:Bounds x="680" y="503" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T4" bpmnElement="T4"><dc:Bounds x="870" y="353" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_G1" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="1110" y="370" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1075" y="422" width="120" height="44" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T5" bpmnElement="T5"><dc:Bounds x="1250" y="503" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T6" bpmnElement="T6"><dc:Bounds x="1440" y="653" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_E1" bpmnElement="E1"><dc:Bounds x="1687" y="677" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1650" y="717" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T7" bpmnElement="T7"><dc:Bounds x="1250" y="353" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_T8" bpmnElement="T8"><dc:Bounds x="1440" y="503" width="150" height="84" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_E2" bpmnElement="E2"><dc:Bounds x="1687" y="227" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1650" y="267" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sh_N1" bpmnElement="N1"><dc:Bounds x="958" y="213" width="200" height="64" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Ed_F01" bpmnElement="F01">
        <di:waypoint x="203" y="95" />
        <di:waypoint x="300" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F02" bpmnElement="F02">
        <di:waypoint x="450" y="95" />
        <di:waypoint x="470" y="95" />
        <di:waypoint x="470" y="245" />
        <di:waypoint x="490" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F03" bpmnElement="F03">
        <di:waypoint x="640" y="245" />
        <di:waypoint x="660" y="245" />
        <di:waypoint x="660" y="545" />
        <di:waypoint x="680" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F04" bpmnElement="F04">
        <di:waypoint x="830" y="545" />
        <di:waypoint x="850" y="545" />
        <di:waypoint x="850" y="395" />
        <di:waypoint x="870" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F05" bpmnElement="F05">
        <di:waypoint x="1020" y="395" />
        <di:waypoint x="1110" y="395" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F06" bpmnElement="F06">
        <di:waypoint x="1135" y="420" />
        <di:waypoint x="1135" y="545" />
        <di:waypoint x="1250" y="545" />
        <bpmndi:BPMNLabel><dc:Bounds x="1141" y="474" width="19" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F07" bpmnElement="F07">
        <di:waypoint x="1160" y="395" />
        <di:waypoint x="1250" y="395" />
        <bpmndi:BPMNLabel><dc:Bounds x="1166" y="377" width="19" height="16" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F08" bpmnElement="F08">
        <di:waypoint x="1400" y="545" />
        <di:waypoint x="1414" y="545" />
        <di:waypoint x="1414" y="695" />
        <di:waypoint x="1440" y="695" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F09" bpmnElement="F09">
        <di:waypoint x="1590" y="695" />
        <di:waypoint x="1687" y="695" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F10" bpmnElement="F10">
        <di:waypoint x="1400" y="395" />
        <di:waypoint x="1434" y="395" />
        <di:waypoint x="1434" y="545" />
        <di:waypoint x="1440" y="545" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_F11" bpmnElement="F11">
        <di:waypoint x="1590" y="545" />
        <di:waypoint x="1638" y="545" />
        <di:waypoint x="1638" y="245" />
        <di:waypoint x="1687" y="245" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Ed_As_N1" bpmnElement="As_N1"><di:waypoint x="958" y="245" /><di:waypoint x="640" y="245" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
